# X (Twitter) ログイン情報
X_USERNAME=your_x_username
X_PASSWORD=your_x_password
X_EMAIL=your_email@example.com

# サービス情報
SERVICE_URL=https://your-service-url.com
SERVICE_NAME=レポート支援AI

# 投稿設定
POST_INTERVAL_MINUTES=60        # 投稿間隔（分）
CTA_FREQUENCY=4                 # 何投稿に1回CTAを入れるか
HEADLESS=false                  # false=ブラウザ表示あり、true=バックグラウンド

# 分析設定
ENGAGE_CHECK_DELAY_MINUTES=45  # 投稿後何分後にエンゲージ計測するか

# DB パス（変更不要）
DB_PATH=./data/sns-bot.db
COOKIES_PATH=./cookies/session.json
LOG_PATH=./logs/bot.log
