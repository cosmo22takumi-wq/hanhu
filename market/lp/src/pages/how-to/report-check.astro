---
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const APP_URL = 'https://report-saas-bay.vercel.app'

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "レポートを提出する前にAIで添削してもらえますか？",
      "acceptedAnswer": { "@type": "Answer", "text": "ポチレポのAI添削機能を使えば、自分で書いたレポートを貼り付けるだけで、誤字脱字・論理の飛躍・引用や根拠の不足・構成のバランスをAIが厳しくチェックし、具体的な改善点を指摘してくれます。7日間無料トライアル後、月額¥500のプランに含まれ、月20回まで使えます。" }
    },
    {
      "@type": "Question",
      "name": "AI添削はどんな点を指摘してくれますか？",
      "acceptedAnswer": { "@type": "Answer", "text": "誤字脱字・表記ゆれ、論理の飛躍や説明不足な箇所、根拠やデータの不足、序論・本論・結論の構成バランス、テーマへの適合度、です/ます調とである調の混在などの文体の一貫性をチェックし、重要度別に改善提案を提示します。" }
    },
    {
      "@type": "Question",
      "name": "竹中平蔵さんの添削サービスのようなものですか？",
      "acceptedAnswer": { "@type": "Answer", "text": "考え方は近いですが、有料の添削サービスは1件あたり数千円かかり、結果が届くまで数日かかることが多いです。ポチレポのAI添削は月額¥500のプランに含まれており、月20回までその場で結果が返ってきます。" }
    },
    {
      "@type": "Question",
      "name": "AIで書いたレポートも添削できますか？",
      "acceptedAnswer": { "@type": "Answer", "text": "はい。ポチレポでAI生成したレポートも、自分で手直しした後にAI添削にかければ、提出前の最終チェックとして使えます。自分で一から書いたレポートのチェックにも使えます。" }
    }
  ]
}
---

<Base
  title="レポートの評価が不安な人へ｜AI添削で提出前チェック【2026年】"
  description="「このレポートで単位もらえるか不安」「提出前に誰かにチェックしてほしい」——そんな大学生のためのAI添削機能。誤字脱字・論理の飛躍・引用不足・構成のバランスをAIが厳しく指摘。7日間無料トライアル後、月額¥500で月20回まで使えます。"
  canonical="https://pochi-repo.jp/how-to/report-check/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <Header />

  <main>

    <section class="bg-gradient-to-br from-indigo-50 to-white py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs font-semibold text-indigo-600 mb-3 uppercase tracking-wide">提出前チェック</p>
        <h1 class="text-3xl sm:text-4xl font-black text-gray-900 mb-4 leading-tight">
          「このレポートで<br class="sm:hidden" />大丈夫かな…」<br />
          <span class="bg-gradient-to-r from-indigo-500 to-violet-500 bg-clip-text text-transparent">
            提出前にAIが添削
          </span>
        </h1>
        <p class="text-gray-600 leading-relaxed mb-8">
          書き終えたけど評価が不安。誤字脱字や論理のおかしいところを誰かにチェックしてほしい。<br class="hidden sm:block" />
          ポチレポの<strong>AI添削</strong>なら、自分で書いたレポートを貼り付けるだけで、教授目線の厳しいチェックがその場で返ってきます。
        </p>
        <a href={APP_URL} class="inline-flex items-center justify-center bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold px-7 py-3 rounded-xl hover:opacity-90 transition shadow-md">
          AI添削を使ってみる →
        </a>
        <p class="text-gray-400 text-xs mt-3">7日間無料トライアル・その後月額¥500で利用可能</p>
      </div>
    </section>

    <section class="py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 mb-2">「評価が不安」は文系大学生の"あるある"</h2>
        <p class="text-gray-500 text-sm mb-8">こんな悩み、心当たりありませんか？</p>

        <div class="space-y-4">
          {[
            {
              num: '01',
              title: '提出してから「論理が変じゃないか」気になる',
              desc: '書いている時は気づかなくても、提出した後に「あの主張、根拠が薄かったかも」「話が飛んでいたかも」と不安になることはよくあります。提出後では修正できません。',
            },
            {
              num: '02',
              title: '誤字脱字・表記ゆれをチェックする時間がない',
              desc: '締め切り直前になるほど見直しの時間が削られ、「です・ます」と「である」が混在したまま提出してしまうケースも少なくありません。',
            },
            {
              num: '03',
              title: '友達や先輩に見せるのは気が引ける',
              desc: '「こんなレベルのものを見せるのは恥ずかしい」「頼める人がいない」という人も多く、結局誰にもチェックされないまま提出することになりがちです。',
            },
          ].map(({ num, title, desc }) => (
            <div class="border border-gray-200 rounded-xl p-5 bg-white">
              <div class="flex items-start gap-4">
                <span class="text-3xl font-black text-gray-200 shrink-0">{num}</span>
                <div class="flex-1">
                  <p class="font-bold text-gray-900 mb-2">{title}</p>
                  <p class="text-sm text-gray-600 leading-relaxed">{desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14 px-4 border-b border-gray-100 bg-gray-50">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 mb-2">AI添削が指摘してくれること</h2>
        <p class="text-gray-500 text-sm mb-8">レポートを貼り付けるだけで、教授目線の6つの観点からチェック</p>

        <div class="grid sm:grid-cols-2 gap-4">
          {[
            { title: '誤字脱字・表記ゆれ', desc: '見落としがちな入力ミスや表記の不統一を指摘' },
            { title: '論理の飛躍・説明不足', desc: '主張と根拠がつながっているか、説明が足りない箇所を指摘' },
            { title: '引用・根拠の不足', desc: '具体例やデータに基づかない断定をチェック' },
            { title: '構成のバランス', desc: '序論・本論・結論がきちんと揃っているかを確認' },
            { title: 'テーマへの適合度', desc: '課題の問いから論点がずれていないかを確認' },
            { title: '文体の一貫性', desc: '「です・ます」と「である」調の混在などをチェック' },
          ].map(({ title, desc }) => (
            <div class="border border-gray-200 rounded-xl p-4 bg-white">
              <p class="font-bold text-gray-900 text-sm mb-1">{title}</p>
              <p class="text-xs text-gray-600 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 mb-2">外部の添削サービスとの違い</h2>
        <p class="text-gray-500 text-sm mb-8">1件数千円・数日待ちの添削サービスと比べて</p>

        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-gray-200 rounded-xl overflow-hidden">
            <thead class="bg-gray-100 text-gray-700">
              <tr>
                <th class="px-4 py-3 text-left font-semibold"></th>
                <th class="px-4 py-3 text-left font-semibold">外部の有料添削サービス</th>
                <th class="px-4 py-3 text-left font-semibold">ポチレポ AI添削</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
              <tr>
                <td class="px-4 py-3 font-semibold text-gray-900">料金</td>
                <td class="px-4 py-3 text-gray-600">1件あたり¥2,000前後</td>
                <td class="px-4 py-3 text-gray-600">月¥500で月20回まで</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-gray-900">結果が届くまで</td>
                <td class="px-4 py-3 text-gray-600">数日〜1週間程度</td>
                <td class="px-4 py-3 text-gray-600">その場で数十秒</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-gray-900">提出直前の利用</td>
                <td class="px-4 py-3 text-gray-600">間に合わないことが多い</td>
                <td class="px-4 py-3 text-gray-600">締め切り直前でもOK</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-xs text-gray-400 mt-3">※ 外部サービスの料金・納期は一般的な相場の一例です</p>
      </div>
    </section>

    <section class="py-14 px-4 bg-gradient-to-r from-indigo-600 to-violet-600 text-white text-center">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl font-black mb-3">提出前のひと手間で、安心して出せる</h2>
        <p class="text-indigo-100 mb-6 text-sm leading-relaxed">
          自分で書いたレポートを貼り付けるだけ。AIが厳しくチェックして、改善点を具体的に教えてくれます。<br />
          レポート作成からAI添削まで、ポチレポひとつで完結します。
        </p>
        <a href={APP_URL} class="inline-flex items-center gap-2 bg-white text-indigo-600 font-bold text-base rounded-xl px-8 py-4 hover:bg-indigo-50 transition shadow-lg">
          ポチレポを使ってみる →
        </a>
        <p class="text-indigo-200 text-xs mt-3">7日間無料トライアル・その後月額¥500でAI添削も使い放題</p>
      </div>
    </section>

    <section class="py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 mb-8">よくある質問</h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map(item => (
            <details class="border border-gray-200 rounded-xl overflow-hidden bg-white">
              <summary class="flex justify-between items-center px-5 py-4 cursor-pointer font-semibold text-gray-800 hover:bg-gray-50 transition-colors text-sm">
                <span>{item.name}</span>
                <svg class="w-4 h-4 text-gray-400 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="px-5 pb-5 pt-3 text-gray-600 text-sm leading-relaxed border-t border-gray-100">
                {item.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="py-12 px-4 border-t border-gray-100">
      <div class="max-w-3xl mx-auto">
        <p class="font-semibold text-gray-700 mb-4">関連コンテンツ</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {[
            { href: '/how-to/ai-report-guide/', title: 'AIを使ったレポートの正しい作り方', desc: 'バレないではなく出せるレベルを目指す方法' },
            { href: '/how-to/report-structure/', title: 'レポートの構成（序論・本論・結論）の書き方', desc: '評価される構成の作り方を解説' },
            { href: '/tools/citation/', title: '参考文献フォーマット自動生成ツール', desc: 'APA・MLA・日本語形式に対応した無料ツール' },
          ].map(({ href, title, desc }) => (
            <a href={href} class="block border border-gray-200 rounded-xl p-4 hover:border-indigo-300 hover:bg-indigo-50/30 transition">
              <p class="font-semibold text-sm text-gray-900 mb-1">{title}</p>
              <p class="text-xs text-gray-500">{desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Base>
