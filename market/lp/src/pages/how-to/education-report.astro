---
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const APP_URL = 'https://report-saas-bay.vercel.app'

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "教育学レポートで「授業内容を踏まえて」はどう書きますか？",
      "acceptedAnswer": { "@type": "Answer", "text": "授業で使われた教科書・参考資料・先生の発言を根拠として引用しながら論じることです。録音や授業ノートを参照しつつ「〇〇氏（授業内）によれば〜」「授業で取り上げられた〜理論に基づけば」という形で書くと、授業内容を踏まえていることが伝わります。" }
    },
    {
      "@type": "Question",
      "name": "教育学レポートに使える参考文献はどこで探しますか？",
      "acceptedAnswer": { "@type": "Answer", "text": "CiNii・J-STAGEで「教育心理学」「学習理論」「カリキュラム」などのキーワードで検索できます。また授業で指定された教科書が最もよい一次資料です。大学の電子図書館（Maruzen eBook等）も活用できます。" }
    },
    {
      "@type": "Question",
      "name": "教育実習後のレポートはどう書きますか？",
      "acceptedAnswer": { "@type": "Answer", "text": "実習中の具体的な経験（観察・実践）を事例として挙げ、そこに授業で学んだ理論を接続して分析する形が一般的です。「〜という場面を観察した。これはピアジェの〜理論で説明できる」というように、経験と理論を結びつける構成が評価されます。" }
    }
  ]
}
---

<Base
  title="教育学レポートの書き方｜授業内容を踏まえた分析・参考文献まで大学生向け解説"
  description="教育学レポートの書き方を解説。「授業内容を踏まえて論じよ」の答え方、教育理論の引用方法、実習レポートの構成まで。ポチレポは授業録音・スライドを読み込んで教育学文体の叩き台を生成。"
  canonical="https://pochi-repo.jp/how-to/education-report/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <Header />

  <main>

    <section class="bg-gradient-to-br from-emerald-50 to-white py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs font-semibold text-emerald-600 mb-3 uppercase tracking-wide">学部別ガイド</p>
        <h1 class="text-3xl sm:text-4xl font-black text-gray-900 mb-4 leading-tight">
          教育学レポートの書き方<br />
          <span class="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent">
            授業内容を踏まえた論述の方法
          </span>
        </h1>
        <p class="text-gray-600 leading-relaxed mb-8">
          教育学レポートで頻出の「授業内容を踏まえて論じなさい」。<br class="hidden sm:block" />
          授業スライド・録音・教科書の使い方から考察の書き方まで解説します。
        </p>
        <a href={APP_URL} class="inline-flex items-center justify-center bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-bold px-7 py-3 rounded-xl hover:opacity-90 transition shadow-md">
          教育学向けレポートをポチレポで作る →
        </a>
      </div>
    </section>

    <section class="py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 mb-2">「授業内容を踏まえて論じなさい」への答え方</h2>
        <p class="text-gray-500 text-sm mb-8">ChatGPTにはできない課題です。授業の中身を使ってください。</p>

        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 mb-8">
          <p class="text-sm font-bold text-amber-700 mb-2">なぜChatGPTでは答えられないか</p>
          <p class="text-sm text-gray-700 leading-relaxed">
            ChatGPTはあなたの授業の内容を知りません。「教育学の一般的な知識」で書くことはできても、「あの先生がA大学のあの授業で話したこと」には触れられません。「授業内容を踏まえて」は、自分の授業資料を使って書く必要があります。
          </p>
        </div>

        <div class="space-y-4 mb-8">
          {[
            {
              step: '授業資料を準備する',
              items: [
                '授業スライドPDF（先生が配布したもの）',
                '授業中の録音ファイル',
                '指定教科書のURL（大学の電子図書館）',
                '自分のノート・板書メモ',
              ],
            },
            {
              step: '資料から「論点」を探す',
              items: [
                '先生が特に強調して話していた部分',
                '授業で紹介された理論・研究者の名前',
                '「〜という問題がある」と言及された社会課題',
                '複数の授業にまたがるキーワード',
              ],
            },
            {
              step: '論点に「問い」をつける',
              items: [
                '「なぜ〜なのか」「どうすれば〜できるか」という形で問いを作る',
                '授業の理論を使って答えを展開する',
                '自分の考えを「〜と考えられる」「〜が示唆される」で表現',
              ],
            },
          ].map(({ step, items }) => (
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
              <p class="font-bold text-emerald-700 text-sm mb-3">{step}</p>
              <ul class="space-y-1.5">
                {items.map(item => (
                  <li class="text-sm text-gray-600 flex gap-2">
                    <span class="text-emerald-500 shrink-0">✓</span>{item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14 px-4 bg-gray-50 border-b border-gray-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 mb-2">ポチレポで授業録音からレポートを書く方法</h2>
        <p class="text-gray-500 text-sm mb-8">「授業を踏まえたレポート」が3分で作れる理由</p>

        <div class="space-y-3">
          {[
            { n: '1', title: '授業録音をアップロード', desc: '90分の講義録音をそのまま入れてOK。Whisperで自動文字起こし→資料化されます。' },
            { n: '2', title: 'テーマと学部を入力', desc: '「教育学部・2000字・アクティブラーニングについて論じなさい」のように入力。' },
            { n: '3', title: '叩き台が生成される', desc: '授業で話された内容をベースに、教育学の文体で序論〜結論まで生成されます。' },
          ].map(({ n, title, desc }) => (
            <div class="flex gap-4 items-start bg-white rounded-xl border border-gray-100 p-4">
              <div class="w-8 h-8 rounded-full bg-emerald-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {n}
              </div>
              <div>
                <p class="font-bold text-gray-900 text-sm mb-0.5">{title}</p>
                <p class="text-sm text-gray-500 leading-relaxed">{desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 bg-emerald-50 rounded-2xl p-5 border border-emerald-100">
          <p class="text-sm font-bold text-emerald-700 mb-2">なぜ「授業内容を踏まえて」に答えられるか</p>
          <p class="text-sm text-gray-700 leading-relaxed">
            ポチレポはあなたが入れた資料の内容を根拠に書きます。授業録音・スライドを入れると、先生が授業で話したことが引用の根拠になります。ChatGPTが知らない「この授業の内容」がレポートに反映されるため、先生に「授業を聞いていますね」と言われた学生も実際にいます。
          </p>
        </div>
      </div>
    </section>

    <section class="py-16 px-4 bg-gradient-to-br from-emerald-700 to-teal-700 text-white text-center">
      <div class="max-w-xl mx-auto">
        <p class="text-emerald-200 text-sm font-semibold mb-3">教育学レポートに特化</p>
        <h2 class="text-2xl sm:text-3xl font-black mb-4">授業録音・スライドから<br />「授業を踏まえた」レポートを生成</h2>
        <p class="text-emerald-100 text-sm leading-relaxed mb-8">
          ChatGPTには書けない「あなたの授業の内容」でレポートを作れる。<br />
          架空の参考文献は出ません。入れた資料だけを根拠にします。
        </p>
        <a href={APP_URL} class="inline-flex items-center justify-center gap-2 bg-white text-emerald-700 font-bold rounded-xl px-8 py-4 hover:bg-emerald-50 transition shadow-xl">
          無料で試す（2回まで）→
        </a>
        <p class="text-emerald-300 text-xs mt-3">登録30秒 · クレジットカード不要</p>
      </div>
    </section>

  </main>

  <Footer />
</Base>
