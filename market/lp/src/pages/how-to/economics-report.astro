---
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const APP_URL = 'https://report-saas-bay.vercel.app'
---

<Base
  title="経済学部レポートの書き方｜統計・グラフ引用とAPA形式を完全解説"
  description="経済学部レポートの書き方を解説。統計データ・グラフの引用方法、APA形式の参考文献、実証分析レポートの構成まで。ポチレポは経済学部の文体システムに対応。"
  canonical="https://pochi-repo.jp/how-to/economics-report/"
>
  <Header />

  <main>

    <section class="bg-gradient-to-br from-green-50 to-white py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs font-semibold text-green-600 mb-3 uppercase tracking-wide">学部別ガイド</p>
        <h1 class="text-3xl sm:text-4xl font-black text-gray-900 mb-4 leading-tight">
          経済学部レポートの書き方<br />
          <span class="bg-gradient-to-r from-green-600 to-emerald-600 bg-clip-text text-transparent">
            統計・グラフ・APA引用形式
          </span>
        </h1>
        <p class="text-gray-600 leading-relaxed mb-8">
          経済学部レポートは「データに基づく論証」が命です。<br class="hidden sm:block" />
          統計データの引用方法・APA形式・実証分析の書き方を解説します。
        </p>
        <a href={APP_URL} class="inline-flex items-center justify-center bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold px-7 py-3 rounded-xl hover:opacity-90 transition shadow-md">
          経済学部向けレポートをポチレポで作る →
        </a>
      </div>
    </section>

    <section class="py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 mb-2">経済学部レポートの基本構成</h2>
        <p class="text-gray-500 text-sm mb-8">理論レポートと実証レポートで構成が異なる</p>

        <div class="grid sm:grid-cols-2 gap-6 mb-8">
          <div>
            <p class="font-bold text-gray-900 text-sm mb-3 bg-green-50 px-3 py-2 rounded-lg">理論系レポートの構成</p>
            <ol class="space-y-2">
              {[
                '序論：問題設定・研究の目的',
                '理論的背景：先行研究・既存理論の整理',
                '分析：理論モデルの展開・論証',
                '考察：理論の含意・現実への適用',
                '結論：まとめと今後の課題',
                '参考文献',
              ].map((item, i) => (
                <li class="flex gap-2 text-sm text-gray-700">
                  <span class="text-green-600 shrink-0 font-bold">{i + 1}.</span>
                  {item}
                </li>
              ))}
            </ol>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm mb-3 bg-emerald-50 px-3 py-2 rounded-lg">実証系レポートの構成</p>
            <ol class="space-y-2">
              {[
                '序論：リサーチクエスチョンと仮説',
                '先行研究レビュー',
                'データ・分析手法の説明',
                '分析結果（表・グラフ付き）',
                '考察：結果の解釈・先行研究との比較',
                '結論：まとめと限界',
                '参考文献',
              ].map((item, i) => (
                <li class="flex gap-2 text-sm text-gray-700">
                  <span class="text-emerald-600 shrink-0 font-bold">{i + 1}.</span>
                  {item}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="py-14 px-4 border-b border-gray-100 bg-gray-50">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 mb-2">統計データ・グラフの引用方法</h2>
        <p class="text-gray-500 text-sm mb-8">経済学部レポートで必須のデータ引用の作法</p>

        <div class="space-y-4">
          {[
            {
              title: '政府統計の引用（e-Stat）',
              format: '著者/機関名（年）. タイトル. URL から取得（取得日）',
              example: '総務省統計局（2023）. 「労働力調査 2023年次」. https://www.stat.go.jp/data/roudou/ より取得（2026年6月1日）',
              sources: ['e-Stat（政府統計の総合窓口）', '日本銀行（金融・経済統計）', '内閣府（国民経済計算）', '厚生労働省（雇用・賃金統計）'],
            },
            {
              title: '図表の本文への組み込み方',
              format: '図表番号と出所を必ず付ける',
              example: '「図1　日本のGDP成長率推移（2000-2023年）\\n出所：内閣府（2024）国民経済計算より筆者作成」',
              sources: ['「筆者作成」はデータから自分でグラフを作った場合', '「出所：〇〇より引用」は既存の図表をそのまま使う場合', '本文中で「図1が示すように〜」と言及する'],
            },
          ].map(({ title, format, example, sources }) => (
            <div class="border border-gray-200 rounded-xl p-5 bg-white">
              <p class="font-bold text-gray-900 text-sm mb-3">{title}</p>
              <div class="bg-green-50 rounded-lg px-4 py-3 mb-3">
                <p class="text-xs font-semibold text-green-700 mb-1">引用形式</p>
                <p class="text-sm text-gray-700">{format}</p>
              </div>
              <div class="bg-gray-50 rounded-lg px-4 py-3 mb-3">
                <p class="text-xs font-semibold text-gray-500 mb-1">例</p>
                <p class="text-sm text-gray-700 whitespace-pre-line">{example}</p>
              </div>
              <ul class="space-y-1">
                {sources.map(s => (
                  <li class="flex gap-2 text-xs text-gray-600">
                    <span class="text-green-500 shrink-0">→</span>
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 mb-2">APA形式の参考文献の書き方</h2>
        <p class="text-gray-500 text-sm mb-8">経済学・社会科学系で最も広く使われる引用形式</p>

        <div class="space-y-3">
          {[
            {
              type: '学術論文',
              format: '著者名（出版年）. 論文タイトル. 雑誌名, 巻(号), 開始頁–終了頁.',
              example: '田中太郎（2022）. 日本における賃金停滞の要因分析. 経済学研究, 58(2), 123–145.',
            },
            {
              type: '書籍',
              format: '著者名（出版年）. 書名. 出版社.',
              example: '山田花子（2021）. マクロ経済学入門. 東京大学出版会.',
            },
            {
              type: 'ウェブサイト・政府統計',
              format: '機関名（取得年）. タイトル. URL',
              example: '総務省統計局（2024）. 消費者物価指数. https://www.stat.go.jp/data/cpi/',
            },
            {
              type: '本文中の引用（括弧表記）',
              format: '（著者名, 出版年, 頁数）',
              example: '「賃金の停滞は労働市場の構造変化に起因する（田中, 2022, p. 125）。」',
            },
          ].map(({ type, format, example }) => (
            <div class="border border-gray-200 rounded-xl p-5 bg-white">
              <p class="font-bold text-gray-900 text-sm mb-2">{type}</p>
              <div class="bg-gray-100 rounded px-3 py-2 mb-2 font-mono text-xs text-gray-600">{format}</div>
              <p class="text-sm text-gray-700">{example}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14 px-4 bg-gradient-to-r from-indigo-600 to-violet-600 text-white text-center">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl font-black mb-3">経済学部の文体・APA形式でレポートを自動生成</h2>
        <p class="text-indigo-100 mb-6 text-sm leading-relaxed">
          ポチレポは経済学部向けの文体・APA形式の参考文献リスト生成に対応。<br />
          テーマと資料を入れるだけで経済学部向けのレポートが完成します。
        </p>
        <a href={APP_URL} class="inline-flex items-center gap-2 bg-white text-indigo-600 font-bold text-base rounded-xl px-8 py-4 hover:bg-indigo-50 transition shadow-lg">
          ポチレポを無料で試す →
        </a>
        <p class="text-indigo-200 text-xs mt-3">Googleアカウントで30秒登録・2回まで無料</p>
      </div>
    </section>

    <section class="py-12 px-4 border-t border-gray-100">
      <div class="max-w-3xl mx-auto">
        <p class="font-semibold text-gray-700 mb-4">関連コンテンツ</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {[
            { href: '/how-to/citation/', title: '参考文献の書き方 完全ガイド', desc: 'APA・MLA・日本語形式の違いと書き方' },
            { href: '/how-to/cinii/', title: 'CiNiiで経済学論文を探す', desc: '経済学系の学術論文を検索する手順' },
          ].map(({ href, title, desc }) => (
            <a href={href} class="block border border-gray-200 rounded-xl p-4 hover:border-indigo-300 hover:bg-indigo-50/30 transition">
              <p class="font-semibold text-sm text-gray-900 mb-1">{title}</p>
              <p class="text-xs text-gray-500">{desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Base>
