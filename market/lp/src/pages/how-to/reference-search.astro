---
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const APP_URL = 'https://report-saas-bay.vercel.app'

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "大学レポートで使える参考文献の探し方は？",
      "acceptedAnswer": { "@type": "Answer", "text": "CiNii（国内学術論文）・大学の電子図書館・Google Scholar（英語論文含む）の3つが主な探し場所です。テーマのキーワードで検索し、査読あり・大学図書館で入手可能な文献を優先して選びましょう。ポチレポのStandard以上ならCiNii論文の自動検索・引用ができます。" }
    },
    {
      "@type": "Question",
      "name": "テーマで検索しても論文が見つかりません。どうすればいいですか？",
      "acceptedAnswer": { "@type": "Answer", "text": "キーワードを変えて試してみましょう。例えば「環境問題」→「気候変動 政策」「CO2 排出量」などより具体的に。それでも見つからない場合は、テーマの上位概念（「環境問題全般」→「環境政策」）で探すと関連論文が見つかります。" }
    },
    {
      "@type": "Question",
      "name": "ウィキペディアを参考文献として使ってもいいですか？",
      "acceptedAnswer": { "@type": "Answer", "text": "大学のレポートではウィキペディアは参考文献として認められないのが一般的です。ウィキペディアは誰でも編集できるため学術的な信頼性がなく、多くの教授が明示的に禁止しています。代わりにCiNii論文や大学の電子図書館の文献を使いましょう。" }
    }
  ]
}
---

<Base
  title="大学レポートの参考文献が見つからない！探し方と使い方【2026年】"
  description="大学レポートの参考文献の探し方を解説。CiNii・電子図書館・Google Scholarの使い方と、見つからないときの対処法。ポチレポなら架空の参考文献がゼロ・実在する文献だけで3分で叩き台。"
  canonical="https://pochi-repo.jp/how-to/reference-search/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <Header />

  <main>

    <section class="bg-gradient-to-br from-indigo-50 to-white py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs font-semibold text-indigo-600 mb-3 uppercase tracking-wide">参考文献の探し方</p>
        <h1 class="text-3xl sm:text-4xl font-black text-gray-900 mb-4 leading-tight">
          参考文献探しで<br />
          <span class="bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent">
            2時間消えるのをやめる
          </span>
        </h1>
        <p class="text-gray-600 leading-relaxed mb-8">
          どこを探せばいいかわからない、検索しても出てこない——<br class="hidden sm:block" />
          参考文献探しを効率化する3つのデータベースと使い方を解説します。
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={APP_URL} class="inline-flex items-center justify-center bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold px-7 py-3 rounded-xl hover:opacity-90 transition shadow-md">
            ポチレポで自動検索 →
          </a>
          <a href="#search-guide" class="inline-flex items-center justify-center border border-gray-300 text-gray-600 font-medium px-7 py-3 rounded-xl hover:bg-gray-50 transition text-sm">
            探し方ガイドを見る ↓
          </a>
        </div>
      </div>
    </section>

    <section id="search-guide" class="py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 mb-2">使うべき3つのデータベース</h2>
        <p class="text-gray-500 text-sm mb-8">大学レポートで使える信頼性の高い文献はここで見つかる</p>

        <div class="space-y-4">
          {[
            {
              name: 'CiNii（サイニィ）',
              url: 'cir.nii.ac.jp',
              badge: '国内論文に強い',
              color: 'indigo',
              pros: '国内の学術論文・学会誌が2,000万件以上。日本語で書かれた文系・理系問わず使える。大学Wi-Fiで全文無料閲覧できる論文も多数。',
              cons: '英語論文は少ない。ニッチなテーマは見つからないことがある。',
              tip: '検索後に「論文」タブを選び「機関リポジトリ等」にチェックを入れると無料で読める論文が増える。',
            },
            {
              name: '大学の電子図書館',
              url: '大学ポータルからログイン',
              badge: '学術書に強い',
              color: 'violet',
              pros: 'Maruzen eBook・KinoDen・丸善Knowledge Workerなど。大学が購入した学術書・教科書にフルアクセスできる。URLをポチレポに貼るだけで内容を資料にできる。',
              cons: '大学によってラインアップが異なる。ログインが必要。',
              tip: '大学のウェブサイトで「電子図書館」または「電子ブック」で検索するとアクセス方法が見つかる。',
            },
            {
              name: 'Google Scholar',
              url: 'scholar.google.com',
              badge: '英語論文に強い',
              color: 'emerald',
              pros: '世界中の学術論文を横断検索できる。被引用数が多い論文を優先表示。学術書の章・抜粋も検索対象。',
              cons: 'PDFが無料で読めない論文も多い（大学のVPNで全文閲覧できることがある）。',
              tip: '「〜 filetype:pdf」と検索すると無料公開中のPDFが見つかりやすい。',
            },
          ].map(({ name, url, badge, color, pros, cons, tip }) => (
            <div class="border border-gray-200 rounded-xl overflow-hidden bg-white">
              <div class={`px-5 py-3 bg-${color}-50 border-b border-gray-200 flex items-center gap-3`}>
                <span class={`font-black text-${color}-700`}>{name}</span>
                <span class="text-gray-400 text-xs">{url}</span>
                <span class={`ml-auto text-xs font-semibold text-${color}-700 bg-${color}-100 px-2 py-0.5 rounded-full`}>{badge}</span>
              </div>
              <div class="px-5 py-4 space-y-3">
                <div>
                  <p class="text-xs font-semibold text-green-600 mb-1">メリット</p>
                  <p class="text-sm text-gray-700">{pros}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold text-red-500 mb-1">デメリット</p>
                  <p class="text-sm text-gray-600">{cons}</p>
                </div>
                <div class="bg-yellow-50 rounded-lg px-4 py-3">
                  <p class="text-xs font-semibold text-yellow-700 mb-1">使い方のコツ</p>
                  <p class="text-sm text-gray-700">{tip}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 mb-2">「論文が見つからない」ときの対処法</h2>
        <p class="text-gray-500 text-sm mb-8">検索キーワードを変えるだけで見つかることが多い</p>

        <div class="space-y-4">
          {[
            {
              problem: 'キーワードそのままで検索してもヒットしない',
              solutions: [
                'テーマを分解して単語で検索（「電子書籍と読書習慣」→「電子書籍」「読書習慣」）',
                '同義語・関連語で試す（「ストレス」→「精神的負荷」「心理的負担」）',
                '英語に訳して英語論文も探してみる',
              ],
            },
            {
              problem: '論文が出てくるが全文が読めない（有料になっている）',
              solutions: [
                '大学Wi-Fi・VPN接続に切り替える（機関契約で読めることがある）',
                'CiNii の「機関リポジトリ等」にチェックを入れて無料版を探す',
                '著者名でGoogle検索すると著者自身が無料公開していることがある',
              ],
            },
            {
              problem: '論文は見つかったが内容が難しすぎる',
              solutions: [
                'アブストラクト（要旨）だけを読んで要点を使う',
                'その論文の「参考文献」から関連論文を芋づる式に探す',
                '入門書・解説書の「参考文献」一覧から論文を探す',
              ],
            },
          ].map(({ problem, solutions }) => (
            <div class="border border-gray-200 rounded-xl p-5 bg-white">
              <p class="font-bold text-gray-900 text-sm mb-3">状況: {problem}</p>
              <ul class="space-y-2">
                {solutions.map(s => (
                  <li class="flex gap-2 text-sm text-gray-700">
                    <span class="text-indigo-500 shrink-0">→</span>
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14 px-4 bg-gray-50">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl font-black text-gray-900 mb-3">参考文献探しはポチレポに任せる</h2>
        <p class="text-gray-500 mb-8 text-sm leading-relaxed">
          架空の参考文献が出ない。実在する文献だけでレポートを生成。<br />
          参考文献リストも正しい形式で自動生成されます。
        </p>
        <a href={APP_URL} class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold text-base rounded-xl px-8 py-4 hover:opacity-90 transition shadow-lg">
          ポチレポを無料で試す →
        </a>
        <p class="text-xs text-gray-400 mt-3">7日間無料トライアル・その後月額¥500</p>
      </div>
    </section>

    <section class="py-14 px-4 border-b border-gray-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 mb-8">よくある質問</h2>
        <div class="space-y-4">
          {[
            {
              q: '大学レポートで使える参考文献の探し方は？',
              a: 'CiNii（国内学術論文）・大学の電子図書館・Google Scholarの3つが主な探し場所です。テーマのキーワードで検索し、査読あり・大学図書館で入手可能な文献を優先して選びましょう。',
            },
            {
              q: 'テーマで検索しても論文が見つかりません。どうすればいいですか？',
              a: 'キーワードを変えて試してみましょう。例えば「環境問題」→「気候変動 政策」などより具体的に。それでも見つからない場合は、テーマの上位概念で探すと関連論文が見つかります。',
            },
            {
              q: 'ウィキペディアを参考文献として使ってもいいですか？',
              a: '大学のレポートではウィキペディアは参考文献として認められないのが一般的です。誰でも編集できるため学術的信頼性がなく、多くの教授が禁止しています。代わりにCiNii論文や電子図書館の文献を使いましょう。',
            },
          ].map(item => (
            <details class="border border-gray-200 rounded-xl overflow-hidden bg-white">
              <summary class="flex justify-between items-center px-5 py-4 cursor-pointer font-semibold text-gray-800 hover:bg-gray-50 transition-colors text-sm">
                <span>{item.q}</span>
                <svg class="w-4 h-4 text-gray-400 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="px-5 pb-5 pt-3 text-gray-600 text-sm leading-relaxed border-t border-gray-100">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="py-12 px-4 border-t border-gray-100">
      <div class="max-w-3xl mx-auto">
        <p class="font-semibold text-gray-700 mb-4">関連コンテンツ</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {[
            { href: '/how-to/cinii/', title: 'CiNiiの使い方と論文の探し方', desc: 'CiNiiで学術論文を検索する手順' },
            { href: '/how-to/citation/', title: '参考文献の書き方 完全ガイド', desc: 'APA・MLA・日本語形式の違いと書き方' },
          ].map(({ href, title, desc }) => (
            <a href={href} class="block border border-gray-200 rounded-xl p-4 hover:border-indigo-300 hover:bg-indigo-50/30 transition">
              <p class="font-semibold text-sm text-gray-900 mb-1">{title}</p>
              <p class="text-xs text-gray-500">{desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Base>
