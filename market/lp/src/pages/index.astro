---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const APP_URL = 'https://report-saas-bay.vercel.app'

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "ポチレポ",
  "description": "大学生向けの学生特化型AIレポートツール。実在する情報のみを根拠にするため架空の参考文献が出ない。情報の確実性・文章の正確さ・スピードの三つを兼ね備えたAI。",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "Web",
  "offers": [
    { "@type": "Offer", "price": "0", "priceCurrency": "JPY", "name": "無料プラン" },
    { "@type": "Offer", "price": "1000", "priceCurrency": "JPY", "name": "Standardプラン" },
    { "@type": "Offer", "price": "2000", "priceCurrency": "JPY", "name": "Proプラン" }
  ]
}

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ChatGPTと何が違うの？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ChatGPTなど汎用AIは、存在しない論文タイトル・架空の情報をあたかも実在するかのように生成することがあります。ポチレポはあなたが入力した実在の資料だけを根拠に書くため、「この参考文献、実在するの？」と先生に指摘されることがありません。情報の確実性・文章の正確さ・スピードの三つが揃った学生特化型AIです。"
      }
    },
    {
      "@type": "Question",
      "name": "AIを使っていいの？正しい使い方は？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ポチレポの正しい使い方は「自分の資料を入れて、構成と表現をサポートしてもらう」ことです。電子図書館のリンク・授業メモ・自分で探した論文を入力すると、それをベースにした文章が生成されます。ChatGPTと違い「あなたの資料から書く」ので、自分の考えが反映された内容になります。"
      }
    },
    {
      "@type": "Question",
      "name": "無料でどこまで使えますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "無料プランではレポート生成を2回（通算）まで、最大2,000字で利用できます。参考文献フォーマッターはユーザー登録なしで無制限に使えます。"
      }
    },
    {
      "@type": "Question",
      "name": "スマートフォンでも使えますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "はい、スマートフォン・タブレットにも対応しています。ただし長文入力や編集にはパソコンでのご利用をおすすめします。"
      }
    }
  ]
}
---

<Base
  title="ポチレポ｜電子図書館のURLを貼るだけ。授業資料を読んでレポートを書くAI"
  description="大学の電子図書館URL・講義スライドPDF・授業録音をそのまま入れるだけ。ChatGPTが知らない「あなたの授業」の内容でレポートを書くAI。登録30秒・無料から使えます。"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <Header />

  <!-- ===== HERO ===== -->
  <section class="relative min-h-screen flex items-end pb-14 overflow-hidden">

    <!-- Pixel art: majestic mountain landscape, student at summit with laptop, achievement -->
    <div class="absolute inset-0">
      <svg
        viewBox="0 0 80 45"
        preserveAspectRatio="xMidYMid slice"
        class="w-full h-full"
        style="image-rendering: pixelated; image-rendering: crisp-edges"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <!-- =============================== -->
        <!-- PIXEL ART: Majestic mountain    -->
        <!-- landscape, clear sunny day,     -->
        <!-- student at peak with laptop,    -->
        <!-- achievement pose                -->
        <!-- Grid: 80 × 45 px               -->
        <!-- =============================== -->

        <!-- SKY — layered colour bands for depth gradient -->
        <rect width="80" height="5"  fill="#0B1E55"/>
        <rect y="5"  width="80" height="4"  fill="#112B7A"/>
        <rect y="9"  width="80" height="4"  fill="#1A3E99"/>
        <rect y="13" width="80" height="4"  fill="#2252B4"/>
        <rect y="17" width="80" height="4"  fill="#2C64C6"/>
        <rect y="21" width="80" height="4"  fill="#3877D5"/>
        <rect y="25" width="80" height="4"  fill="#488ADF"/>
        <rect y="29" width="80" height="16" fill="#589CE8"/>

        <!-- SUN (upper right, pixel art) -->
        <rect x="64" y="2"  width="1" height="1" fill="#FFE040"/>
        <rect x="67" y="1"  width="1" height="1" fill="#FFE040"/>
        <rect x="70" y="1"  width="1" height="1" fill="#FFE040"/>
        <rect x="73" y="2"  width="1" height="1" fill="#FFE040"/>
        <rect x="63" y="4"  width="1" height="1" fill="#FFE040"/>
        <rect x="75" y="4"  width="1" height="1" fill="#FFE040"/>
        <rect x="63" y="6"  width="1" height="1" fill="#FFE040"/>
        <rect x="75" y="6"  width="1" height="1" fill="#FFE040"/>
        <rect x="64" y="8"  width="1" height="1" fill="#FFE040"/>
        <rect x="67" y="8"  width="1" height="1" fill="#FFE040"/>
        <rect x="70" y="8"  width="1" height="1" fill="#FFE040"/>
        <rect x="73" y="8"  width="1" height="1" fill="#FFE040"/>
        <!-- Sun core -->
        <rect x="65" y="2"  width="9" height="1" fill="#FFD700"/>
        <rect x="64" y="3"  width="11" height="5" fill="#FFD700"/>
        <rect x="65" y="8"  width="9" height="1" fill="#FFD700"/>
        <!-- Bright centre -->
        <rect x="67" y="4"  width="5" height="3" fill="#FFF176"/>

        <!-- BIRDS (tiny pixel V shapes in sky) -->
        <rect x="14" y="6"  width="1" height="1" fill="#223366"/>
        <rect x="16" y="5"  width="1" height="1" fill="#223366"/>
        <rect x="18" y="6"  width="1" height="1" fill="#223366"/>
        <rect x="30" y="4"  width="1" height="1" fill="#1A2D5A"/>
        <rect x="32" y="3"  width="1" height="1" fill="#1A2D5A"/>
        <rect x="34" y="4"  width="1" height="1" fill="#1A2D5A"/>
        <rect x="48" y="7"  width="1" height="1" fill="#2A3D72"/>
        <rect x="50" y="6"  width="1" height="1" fill="#2A3D72"/>
        <rect x="52" y="7"  width="1" height="1" fill="#2A3D72"/>

        <!-- CLOUD 1 (left, x=3–15, y=5–8) -->
        <rect x="5"  y="5"  width="8"  height="1" fill="#FFFFFF"/>
        <rect x="3"  y="6"  width="13" height="2" fill="#FFFFFF"/>
        <rect x="4"  y="8"  width="11" height="1" fill="#C8DCEE"/>

        <!-- CLOUD 2 (centre-left, x=20–33, y=4–7) -->
        <rect x="22" y="4"  width="9"  height="1" fill="#FFFFFF"/>
        <rect x="20" y="5"  width="13" height="2" fill="#FFFFFF"/>
        <rect x="21" y="7"  width="11" height="1" fill="#C8DCEE"/>

        <!-- CLOUD 3 (small, x=42–51, y=6–8) -->
        <rect x="43" y="6"  width="7"  height="1" fill="#FFFFFF"/>
        <rect x="42" y="7"  width="9"  height="1" fill="#FFFFFF"/>
        <rect x="43" y="8"  width="7"  height="1" fill="#C8DCEE"/>

        <!-- FAR MOUNTAIN RANGE (pale blue-grey, jagged pixel silhouette) -->
        <polygon fill="#7090C2" points="
          0,45 0,20
          2,20 2,17 5,17 5,14 8,14 8,11
          10,11 10,9  13,9  13,11
          15,11 15,14 17,14 17,11
          20,11 20,9  22,9  22,7
          25,7  25,9  27,9  27,11
          30,11 30,14 32,14 32,11
          35,11 35,9  38,9  38,11
          40,11 40,14 43,14 43,17
          46,17 46,20 49,20 49,18
          52,18 52,21 55,21 55,19
          58,19 58,22 61,22 61,20
          64,20 64,23 67,23 67,21
          70,21 70,24 73,24 73,22
          76,22 76,25 80,25
          80,45
        "/>

        <!-- FAR MOUNTAIN SNOW CAPS -->
        <rect x="10" y="9"  width="3" height="2" fill="#E0EAFF"/>
        <rect x="11" y="8"  width="1" height="1" fill="#F0F6FF"/>
        <rect x="22" y="7"  width="3" height="2" fill="#E0EAFF"/>
        <rect x="23" y="6"  width="1" height="1" fill="#F8FAFF"/>
        <rect x="35" y="9"  width="3" height="2" fill="#E0EAFF"/>
        <rect x="36" y="8"  width="1" height="1" fill="#F0F6FF"/>

        <!-- NEAR MOUNTAIN RANGE (dark navy, pixel silhouette) -->
        <polygon fill="#243668" points="
          0,45 0,26
          3,26 3,23 6,23 6,20
          9,20 9,17 12,17 12,15
          14,15 14,18 17,18 17,16
          20,16 20,14 23,14 23,17
          25,17 25,15 28,15 28,13
          31,13 31,15 34,15 34,18
          36,18 36,16 39,16 39,14
          42,14 42,17 45,17 45,20
          47,20 47,18 50,18 50,21
          53,21 53,24 56,24 56,22
          59,22 59,25 62,25 62,23
          65,23 65,26 68,26 68,24
          71,24 71,27 74,27 74,25
          77,25 77,28 80,28
          80,45
        "/>

        <!-- NEAR MOUNTAIN SNOW CAPS -->
        <rect x="12" y="15" width="2" height="2" fill="#D8E4FF"/>
        <rect x="13" y="14" width="1" height="1" fill="#EEF2FF"/>
        <rect x="20" y="14" width="3" height="2" fill="#D8E4FF"/>
        <rect x="21" y="13" width="1" height="1" fill="#F0F4FF"/>
        <rect x="28" y="13" width="3" height="2" fill="#D8E4FF"/>
        <rect x="29" y="12" width="1" height="1" fill="#EEF2FF"/>
        <rect x="36" y="14" width="3" height="2" fill="#D8E4FF"/>
        <rect x="37" y="13" width="1" height="1" fill="#EEF2FF"/>

        <!-- DEEP FOREST TREELINE (pixel-art tree tops) -->
        <polygon fill="#183E0C" points="
          0,45 0,35 2,33 4,35 6,31 8,33
          10,30 12,32 14,29 16,31 18,27
          20,29 22,26 24,28 26,25 28,27
          30,24 32,26 34,25 36,27 38,24
          40,26 42,23 44,25 46,24 48,26
          50,25 52,28 54,30 56,29 58,31
          60,30 62,32 64,31 66,33 68,32
          70,34 72,33 74,35 76,35 78,37
          80,36 80,45
        "/>

        <!-- MID-TONE TREE TOP HIGHLIGHTS -->
        <rect x="0"  y="33" width="2" height="2" fill="#286018"/>
        <rect x="6"  y="31" width="2" height="2" fill="#286018"/>
        <rect x="10" y="30" width="2" height="2" fill="#286018"/>
        <rect x="14" y="29" width="2" height="2" fill="#2E6A1C"/>
        <rect x="18" y="27" width="2" height="2" fill="#2E6A1C"/>
        <rect x="22" y="26" width="2" height="2" fill="#347220"/>
        <rect x="26" y="25" width="2" height="2" fill="#347220"/>
        <rect x="30" y="24" width="2" height="2" fill="#347220"/>
        <rect x="34" y="25" width="2" height="2" fill="#286018"/>
        <rect x="38" y="24" width="2" height="2" fill="#286018"/>
        <rect x="42" y="23" width="2" height="2" fill="#347220"/>

        <!-- ROCKY MOUNTAIN PLATEAU (where student sits — right side) -->
        <rect x="38" y="33" width="42" height="1" fill="#3A4A76"/>
        <rect x="36" y="34" width="44" height="2" fill="#2C3A64"/>
        <rect x="36" y="36" width="44" height="1" fill="#3A4A76"/>
        <!-- Ground beneath the plateau -->
        <rect y="37"  width="38" height="8" fill="#162E0A"/>
        <rect x="38" y="37" width="42" height="8" fill="#1C2848"/>

        <!-- ======================================= -->
        <!-- PIXEL ART STUDENT CHARACTER              -->
        <!-- Seated on plateau (right area)          -->
        <!-- Left arm raised in celebration          -->
        <!-- ======================================= -->

        <!-- Raised left arm -->
        <rect x="40" y="22" width="1" height="1" fill="#FFCC88"/>   <!-- hand top -->
        <rect x="40" y="23" width="1" height="1" fill="#FFCC88"/>   <!-- wrist -->
        <rect x="41" y="24" width="1" height="2" fill="#2255BB"/>   <!-- forearm -->
        <rect x="42" y="26" width="1" height="1" fill="#2255BB"/>   <!-- upper arm jnt -->

        <!-- HEAD: hair then face -->
        <rect x="42" y="22" width="1" height="1" fill="#332211"/>   <!-- hair far left -->
        <rect x="43" y="21" width="4" height="1" fill="#332211"/>   <!-- hair top -->
        <rect x="47" y="22" width="1" height="1" fill="#332211"/>   <!-- hair far right -->
        <rect x="42" y="23" width="1" height="3" fill="#332211"/>   <!-- hair left side -->
        <rect x="47" y="23" width="1" height="3" fill="#332211"/>   <!-- hair right side -->
        <rect x="43" y="22" width="4" height="4" fill="#FFCC88"/>   <!-- face -->
        <!-- Eyes (two 1px dots) -->
        <rect x="44" y="23" width="1" height="1" fill="#332211"/>
        <rect x="46" y="23" width="1" height="1" fill="#332211"/>
        <!-- Smile -->
        <rect x="44" y="25" width="1" height="1" fill="#CC6655"/>
        <rect x="45" y="26" width="1" height="1" fill="#CC6655"/>
        <rect x="46" y="25" width="1" height="1" fill="#CC6655"/>

        <!-- TORSO / SHIRT -->
        <rect x="41" y="27" width="8" height="5" fill="#2255BB"/>   <!-- main shirt body -->
        <rect x="41" y="26" width="1" height="1" fill="#2255BB"/>   <!-- left shoulder -->
        <rect x="48" y="26" width="1" height="1" fill="#2255BB"/>   <!-- right shoulder -->
        <!-- Shirt shadow band -->
        <rect x="41" y="30" width="8" height="1" fill="#1A3D88"/>

        <!-- Right arm resting down toward laptop -->
        <rect x="49" y="27" width="1" height="2" fill="#2255BB"/>
        <rect x="50" y="29" width="1" height="1" fill="#FFCC88"/>   <!-- hand -->

        <!-- PANTS (seated, spread out) -->
        <rect x="40" y="32" width="9" height="4" fill="#1A2244"/>
        <rect x="39" y="33" width="1" height="2" fill="#1A2244"/>   <!-- left knee out -->
        <rect x="49" y="33" width="1" height="1" fill="#1A2244"/>   <!-- right -->

        <!-- SHOES -->
        <rect x="39" y="36" width="2" height="1" fill="#0A0A14"/>
        <rect x="48" y="36" width="2" height="1" fill="#0A0A14"/>

        <!-- ======================================= -->
        <!-- PIXEL ART LAPTOP                        -->
        <!-- Open lid, sitting beside student        -->
        <!-- ======================================= -->

        <!-- Screen bezel (dark) -->
        <rect x="51" y="28" width="10" height="7" fill="#0A0A14"/>
        <!-- Screen content (blue) -->
        <rect x="52" y="29" width="8"  height="5" fill="#1A4499"/>
        <!-- Report text lines on screen -->
        <rect x="53" y="30" width="6"  height="1" fill="#4488FF"/>   <!-- title line -->
        <rect x="53" y="31" width="5"  height="1" fill="#2E66CC"/>
        <rect x="53" y="32" width="6"  height="1" fill="#2E66CC"/>
        <rect x="53" y="33" width="4"  height="1" fill="#2E66CC"/>
        <!-- Green ✓ on screen (DONE!) -->
        <rect x="57" y="30" width="1"  height="1" fill="#34C759"/>
        <rect x="58" y="31" width="1"  height="1" fill="#34C759"/>
        <rect x="56" y="32" width="1"  height="1" fill="#34C759"/>
        <!-- Screen glow -->
        <rect x="51" y="35" width="10" height="1" fill="#222238"/>   <!-- keyboard -->
        <rect x="50" y="36" width="12" height="1" fill="#0A0A14"/>   <!-- hinge -->

        <!-- ======================================= -->
        <!-- GOLD STAR SPARKLES (achievement)        -->
        <!-- ======================================= -->

        <!-- Big pixel-cross star near raised hand -->
        <rect x="37" y="17" width="1" height="5" fill="#FFD700"/>   <!-- vertical -->
        <rect x="35" y="19" width="5" height="1" fill="#FFD700"/>   <!-- horizontal -->
        <rect x="36" y="18" width="1" height="1" fill="#FFF176"/>   <!-- top-left diag -->
        <rect x="40" y="18" width="1" height="1" fill="#FFF176"/>   <!-- top-right diag -->
        <rect x="36" y="21" width="1" height="1" fill="#FFF176"/>   <!-- btm-left diag -->
        <rect x="40" y="21" width="1" height="1" fill="#FFF176"/>   <!-- btm-right diag -->

        <!-- Medium pixel-cross star (upper right) -->
        <rect x="57" y="22" width="1" height="5" fill="#FFD700"/>
        <rect x="55" y="24" width="5" height="1" fill="#FFD700"/>
        <rect x="56" y="23" width="1" height="1" fill="#FFF176"/>
        <rect x="60" y="23" width="1" height="1" fill="#FFF176"/>
        <rect x="56" y="26" width="1" height="1" fill="#FFF176"/>
        <rect x="60" y="26" width="1" height="1" fill="#FFF176"/>

        <!-- Small sparkle dots scattered -->
        <rect x="44" y="18" width="1" height="1" fill="#FFD700"/>
        <rect x="50" y="20" width="1" height="1" fill="#FFD700"/>
        <rect x="63" y="27" width="1" height="1" fill="#FFD700"/>
        <rect x="34" y="14" width="1" height="1" fill="#FFE060"/>
        <rect x="64" y="24" width="1" height="1" fill="#FFE060"/>

        <!-- ======================================= -->
        <!-- FLOATING PIXEL ART DOCUMENT (complete)  -->
        <!-- ======================================= -->
        <!-- Paper body -->
        <rect x="28" y="21" width="6" height="8"  fill="#F8F8F4"/>
        <!-- Paper fold corner -->
        <rect x="32" y="21" width="2" height="2"  fill="#E0E0D8"/>
        <rect x="34" y="21" width="1" height="1"  fill="#F8F8F4"/>
        <rect x="33" y="22" width="1" height="1"  fill="#F8F8F4"/>
        <!-- Title line (indigo) -->
        <rect x="29" y="22" width="3" height="1"  fill="#4455CC"/>
        <!-- Body lines (grey) -->
        <rect x="29" y="24" width="4" height="1"  fill="#AAAAAA"/>
        <rect x="29" y="25" width="3" height="1"  fill="#AAAAAA"/>
        <rect x="29" y="26" width="4" height="1"  fill="#AAAAAA"/>
        <!-- Green ✓ badge (complete!) -->
        <rect x="31" y="28" width="2" height="2"  fill="#34C759"/>

        <!-- Pixel dithering on mountain edges for depth -->
        <rect x="2"  y="19" width="1" height="1"  fill="#8AA8D0" opacity="0.5"/>
        <rect x="4"  y="16" width="1" height="1"  fill="#8AA8D0" opacity="0.5"/>
        <rect x="14" y="13" width="1" height="1"  fill="#8AA8D0" opacity="0.5"/>
        <rect x="27" y="12" width="1" height="1"  fill="#8AA8D0" opacity="0.5"/>
        <rect x="40" y="13" width="1" height="1"  fill="#8AA8D0" opacity="0.5"/>

      </svg>
    </div>

    <!-- Gradient overlay: left → transparent for text readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/78 via-black/48 to-black/8 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent pointer-events-none"></div>

    <!-- Hero content -->
    <div class="relative max-w-6xl mx-auto px-4 w-full">
      <div class="max-w-xl">
        <!-- Badge -->
        <p class="inline-flex items-center gap-2 text-xs font-semibold text-indigo-300 border border-indigo-500/40 bg-indigo-950/50 rounded-full px-4 py-1.5 mb-6 tracking-wide">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 inline-block"></span>
          確実性 · 正確さ · スピード — 学生特化型AI
        </p>

        <!-- Main headline -->
        <h1 class="text-5xl sm:text-6xl md:text-7xl font-black text-white leading-[1.04] tracking-tight mb-6">
          ChatGPTは、<br>
          <span class="text-indigo-300">もう古い。</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-gray-300 mb-8 leading-relaxed">
          あなたの授業資料・電子書籍を読んで書くから、<br class="hidden sm:block">
          <strong class="text-white">架空の参考文献が出ない、引用元が全部残る</strong>レポートになる。<br>
          ChatGPTが知らない「あなたの授業」の内容で、3分で叩き台が完成。
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-3 mb-6">
          <a
            href={APP_URL}
            class="inline-flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-base sm:text-lg rounded-xl px-7 py-4 transition shadow-2xl shadow-indigo-900/60"
          >
            無料で始める — Googleで30秒
          </a>
          <a
            href="/tools/citation/"
            class="inline-flex items-center justify-center gap-2 border border-white/30 text-white/90 font-semibold rounded-xl px-5 py-4 hover:bg-white/10 transition text-sm sm:text-base"
          >
            参考文献ツールを試す（登録不要）→
          </a>
        </div>

        <!-- Trust micro-copy -->
        <p class="text-xs text-gray-500">クレジットカード不要 · Googleアカウントで即スタート · 2回まで無料</p>
      </div>
    </div>
  </section>

  <!-- ===== STATS BAR ===== -->
  <section class="bg-[#0a0908] border-y border-gray-800/80 py-10 px-4">
    <div class="max-w-4xl mx-auto grid grid-cols-3 text-center divide-x divide-gray-800">
      <div class="px-4">
        <p class="text-3xl sm:text-4xl font-black text-white">架空引用<span class="text-indigo-400 text-2xl">ゼロ</span></p>
        <p class="text-xs text-gray-500 mt-1.5">実在する情報だけを根拠にする</p>
      </div>
      <div class="px-4">
        <p class="text-3xl sm:text-4xl font-black text-white">最短<span class="text-indigo-400">10</span>分</p>
        <p class="text-xs text-gray-500 mt-1.5">テーマ入力→レポート完成</p>
      </div>
