---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const APP_URL = 'https://report-saas-bay.vercel.app'

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "ポチレポ",
  "description": "大学生のライフハック。CiNii論文自動検索・参考文献フォーマット生成・レポート構成AI。",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "Web",
  "offers": [
    { "@type": "Offer", "price": "0", "priceCurrency": "JPY", "name": "無料プラン" },
    { "@type": "Offer", "price": "1500", "priceCurrency": "JPY", "name": "Standardプラン" },
    { "@type": "Offer", "price": "3000", "priceCurrency": "JPY", "name": "Proプラン" }
  ]
}

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ChatGPTと何が違うの？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ChatGPTは文章生成が得意ですが、実在する学術論文を引用してくれません。ポチレポはCiNii APIと連携して実際の論文を探し、正しい引用フォーマットで文章に組み込みます。"
      }
    },
    {
      "@type": "Question",
      "name": "大学にバレませんか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ポチレポは「全自動生成」ではなく「作業支援」に特化しています。自分の考えや授業メモをもとに構成と表現をサポートするため、最終的には自分で内容を確認・編集することを推奨します。"
      }
    },
    {
      "@type": "Question",
      "name": "無料でどこまで使えますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "無料プランでも月2回のレポート生成が使えます。参考文献フォーマッターは登録不要で無制限に使えます。"
      }
    },
    {
      "@type": "Question",
      "name": "スマートフォンでも使えますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "はい、スマートフォン・タブレットからもご利用いただけます。ただし作業効率の面からパソコンでのご利用をおすすめします。"
      }
    }
  ]
}
---

<Base
  title="ポチレポ｜講義資料とCiNii論文でレポートを書くAI"
  description="大学生のレポート作成を支援するAIツール。講義の録音・資料とCiNii論文を組み合わせて、先生に出せるレポートを最短で作成。参考文献フォーマット自動生成。無料から使えます。"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <Header />

  <!-- ===== HERO ===== -->
  <section class="relative overflow-hidden bg-gradient-to-br from-indigo-50 via-white to-violet-500/5 pt-16 pb-20 px-4">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-100/40 via-transparent to-transparent pointer-events-none" />
    <div class="max-w-4xl mx-auto text-center relative">
      <p class="inline-flex items-center gap-1.5 bg-indigo-50 text-indigo-700 text-xs font-semibold rounded-full px-4 py-1.5 mb-6 border border-indigo-100">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 inline-block"></span>
        文系大学生向け・無料から使えます
      </p>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-gray-900 leading-tight mb-6">
        講義資料と<br class="sm:hidden" />CiNii論文で<br />
        <span class="bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent">
          レポートを書くAI
        </span>
      </h1>

      <p class="text-lg sm:text-xl text-gray-600 mb-4 leading-relaxed">
        授業の録音・資料をAIが読んでCiNii論文と組み合わせ、<br class="hidden sm:block" />
        <strong class="text-gray-800">参考文献つきで先生に出せるレポート</strong>を最短で生成。
      </p>

      <p class="text-sm text-gray-400 mb-8">登録は30秒。Googleアカウントで即スタート。</p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={APP_URL}
          class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold text-lg rounded-xl px-8 py-4 hover:opacity-90 transition shadow-lg shadow-indigo-500/20"
        >
          ✦ 無料で始める
        </a>
        <a
          href="/tools/citation/"
          class="inline-flex items-center justify-center gap-2 bg-white text-gray-700 font-semibold text-base rounded-xl px-6 py-4 hover:bg-gray-50 transition border border-gray-200 shadow-sm"
        >
          参考文献ツールを試す（登録不要）
        </a>
      </div>

      <!-- trust indicators -->
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mt-10 text-xs text-gray-400">
        <span class="flex items-center gap-1"><span class="text-emerald-500">✓</span> クレジットカード不要</span>
        <span class="flex items-center gap-1"><span class="text-emerald-500">✓</span> Googleアカウントで即ログイン</span>
        <span class="flex items-center gap-1"><span class="text-emerald-500">✓</span> 2回まで無料（通算）</span>
        <span class="flex items-center gap-1"><span class="text-emerald-500">✓</span> CiNii論文対応</span>
      </div>
    </div>
  </section>

  <!-- ===== PROBLEM ===== -->
  <section class="py-16 px-4 bg-gray-50">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-black text-center text-gray-900 mb-3">
        こんな悩み、ありませんか？
      </h2>
      <p class="text-center text-gray-500 mb-10">大学生のレポートあるある</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { emoji: '📚', text: '参考文献の書き方がわからない。APA？MLA？日本語形式？' },
          { emoji: '🔍', text: 'CiNiiで論文が探せない。検索しても関係ない論文ばかり出る。' },
          { emoji: '🤖', text: 'ChatGPTで書いたら文章がAI臭い。先生にバレそうで怖い。' },
          { emoji: '📝', text: 'レポートの構成が思いつかない。序論・本論・結論の分け方がわからない。' },
          { emoji: '⏰', text: '締め切りまで時間がない。今から書き始めても間に合わない。' },
          { emoji: '📖', text: '学部によって引用ルールが違う。法学部と文学部で参考文献の書き方が違う。' },
        ].map(({ emoji, text }) => (
          <div class="flex gap-3 bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
            <span class="text-2xl flex-shrink-0">{emoji}</span>
            <p class="text-sm text-gray-600 leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== FEATURES ===== -->
  <section id="features" class="py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-black text-center text-gray-900 mb-3">
        ポチレポが全部解決します
      </h2>
      <p class="text-center text-gray-500 mb-12">ChatGPTとは違う、学術レポート専用の機能</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          {
            icon: '🔬',
            title: 'CiNii論文自動検索',
            badge: '無料から',
            desc: 'テーマを入力するだけで国内最大の学術データベース「CiNii」から関連論文を自動リストアップ。タイトル・著者・掲載誌が一覧で確認できます。',
            points: ['国内2,000万件以上の論文に対応', '複数キーワードで絞り込み可能', '論文の概要も確認できる'],
          },
          {
            icon: '📋',
            title: '参考文献フォーマット自動生成',
            badge: '登録不要',
            desc: '著者名・タイトル・年を入れるだけで、APA・MLA・日本語学術形式の参考文献リストを即生成。コピペするだけで完成します。',
            points: ['APA第7版・MLA第9版対応', '日本語学術形式対応', 'Webサイト・書籍・雑誌論文に対応'],
          },
          {
            icon: '🗂️',
            title: 'レポート構成AI生成',
            badge: 'Standard以上',
            desc: 'テーマと学部を選ぶだけで、序論〜本論〜結論の章立てをAIが提案。何を書けばいいかわからない状態から即座に抜け出せます。',
            points: ['法学・経済・社会学・文学など対応', '章立て＋見出し案まで生成', '構成を自分でカスタマイズ可能'],
          },
          {
            icon: '🎤',
            title: '授業録音→レポート骨子',
            badge: 'Pro限定',
            desc: '授業を録音するだけで自動文字起こし。先生の話をもとにレポートの骨子を自動生成します。授業に集中しながら資料も収集できます。',
            points: ['Whisper AIで高精度文字起こし', '録音→要点→骨子まで自動化', 'ノート代わりに使える'],
          },
        ].map(({ icon, title, badge, desc, points }) => (
          <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition">
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-3">
                <span class="text-3xl">{icon}</span>
                <h3 class="font-bold text-gray-900">{title}</h3>
              </div>
              <span class="text-xs font-semibold bg-indigo-50 text-indigo-700 rounded-full px-2.5 py-1 flex-shrink-0 ml-2">{badge}</span>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">{desc}</p>
            <ul class="space-y-1">
              {points.map(p => (
                <li class="flex items-center gap-2 text-xs text-gray-500">
                  <span class="text-indigo-500 flex-shrink-0">✓</span>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== FREE TOOL HIGHLIGHT ===== -->
  <section class="py-16 px-4 bg-gradient-to-br from-indigo-600 to-violet-600 text-white">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-indigo-200 text-sm font-semibold mb-3">登録なし・完全無料</p>
      <h2 class="text-2xl sm:text-3xl font-black mb-4">
        まずは参考文献フォーマッターを<br class="hidden sm:block" />試してみてください
      </h2>
      <p class="text-indigo-100 mb-8 text-base leading-relaxed">
        著者名・タイトル・発行年を入力するだけで<br class="hidden sm:block" />
        APA・MLA・日本語形式の参考文献が即生成されます。
      </p>
      <a
        href="/tools/citation/"
        class="inline-flex items-center gap-2 bg-white text-indigo-600 font-bold text-base rounded-xl px-8 py-4 hover:bg-indigo-50 transition shadow-lg"
      >
        参考文献ツールを使う（無料・登録不要）→
      </a>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="py-20 px-4 bg-gray-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-black text-center text-gray-900 mb-3">
        使い方はシンプル3ステップ
      </h2>
      <p class="text-center text-gray-500 mb-12">難しい操作は一切なし</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            step: '01',
            icon: '✏️',
            title: 'テーマを入力',
            desc: 'レポートのテーマや課題を入力。学部・文字数・文体も選択するだけ。',
          },
          {
            step: '02',
            icon: '🔍',
            title: 'CiNii論文が集まる',
            desc: '関連する学術論文が自動でリストアップ。使いたい論文にチェックをつけるだけ。',
          },
          {
            step: '03',
            icon: '📄',
            title: '引用付きレポートを出力',
            desc: '参考文献リスト付きのレポート本文をAIが生成。自分で編集して提出へ。',
          },
        ].map(({ step, icon, title, desc }) => (
          <div class="flex flex-col items-center text-center">
            <div class="relative mb-4">
              <div class="w-16 h-16 bg-white border-2 border-indigo-100 rounded-2xl flex items-center justify-center text-2xl shadow-sm">
                {icon}
              </div>
              <span class="absolute -top-2 -right-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white text-xs font-black rounded-full w-6 h-6 flex items-center justify-center">
                {step.slice(1)}
              </span>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">{title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a
          href={APP_URL}
          class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold text-base rounded-xl px-8 py-4 hover:opacity-90 transition shadow-lg shadow-indigo-500/20"
        >
          ✦ 今すぐ試してみる
        </a>
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section id="pricing" class="py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-black text-center text-gray-900 mb-3">料金プラン</h2>
      <p class="text-center text-gray-500 mb-12">まず無料で体験。物足りなくなったらアップグレード。</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <!-- Free -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">無料</p>
          <p class="text-3xl font-black text-gray-900 mb-0.5">¥0</p>
          <p class="text-xs text-gray-400 mb-5">ずっと無料・クレカ不要</p>
          <a href={APP_URL} class="block w-full text-center border border-gray-300 text-gray-700 font-semibold rounded-xl py-2.5 text-sm hover:bg-gray-50 transition mb-5">
            無料で始める
          </a>
          <ul class="space-y-2 text-sm flex-1">
            {[
              { ok: true,  label: 'AI生成 2回まで（通算）' },
              { ok: true,  label: '最大 2,000字' },
              { ok: true,  label: '参考資料 1件まで' },
              { ok: false, label: 'CiNii 論文検索' },
              { ok: false, label: 'ファイル読み込み' },
              { ok: false, label: '音声文字起こし' },
              { ok: false, label: 'Word エクスポート' },
              { ok: false, label: 'PDF エクスポート' },
            ].map(({ ok, label }) => (
              <li class={`flex items-center gap-2 ${ok ? 'text-gray-700' : 'text-gray-300'}`}>
                <span class={`text-xs shrink-0 ${ok ? 'text-emerald-500' : 'text-gray-200'}`}>{ok ? '✓' : '✗'}</span>
                {label}
              </li>
            ))}
          </ul>
        </div>

        <!-- Standard -->
        <div class="bg-white border-2 border-indigo-500 rounded-2xl p-6 shadow-lg relative flex flex-col">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white text-xs font-bold rounded-full px-4 py-1 whitespace-nowrap">
            おすすめ
          </span>
          <p class="text-xs font-semibold text-indigo-600 uppercase tracking-wide mb-1">Standard</p>
          <p class="text-3xl font-black text-gray-900 mb-0.5">¥1,000<span class="text-base font-normal text-gray-500">/月</span></p>
          <p class="text-xs text-gray-400 mb-5">いつでも解約OK</p>
          <a href={APP_URL} class="block w-full text-center bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl py-2.5 text-sm hover:opacity-90 transition mb-5">
            Standardを始める
          </a>
          <ul class="space-y-2 text-sm flex-1">
            {[
              { ok: true,  label: 'AI生成 月40回まで' },
              { ok: true,  label: '最大 5,000字' },
              { ok: true,  label: '参考資料 3件まで' },
              { ok: true,  label: 'CiNii 論文検索' },
              { ok: true,  label: 'ファイル読み込み' },
              { ok: true,  label: '音声文字起こし' },
              { ok: true,  label: 'Word エクスポート' },
              { ok: false, label: 'PDF エクスポート' },
            ].map(({ ok, label }) => (
              <li class={`flex items-center gap-2 ${ok ? 'text-gray-700' : 'text-gray-300'}`}>
                <span class={`text-xs shrink-0 ${ok ? 'text-indigo-500' : 'text-gray-200'}`}>{ok ? '✓' : '✗'}</span>
                {label}
              </li>
            ))}
          </ul>
        </div>

        <!-- Pro -->
        <div class="bg-gray-900 border border-gray-700 rounded-2xl p-6 shadow-sm text-white flex flex-col">
          <p class="text-xs font-semibold text-purple-300 uppercase tracking-wide mb-1">Pro</p>
          <p class="text-3xl font-black mb-0.5">¥2,000<span class="text-base font-normal text-gray-400">/月</span></p>
          <p class="text-xs text-gray-500 mb-5">いつでも解約OK</p>
          <a href={APP_URL} class="block w-full text-center bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold rounded-xl py-2.5 text-sm hover:opacity-90 transition mb-5">
            Proを始める
          </a>
          <ul class="space-y-2 text-sm flex-1">
            {[
              { ok: true, label: 'AI生成 月50回まで' },
              { ok: true, label: '最大 10,000字' },
              { ok: true, label: '参考資料 3件まで' },
              { ok: true, label: 'CiNii 論文検索' },
              { ok: true, label: 'ファイル読み込み' },
              { ok: true, label: '音声文字起こし' },
              { ok: true, label: 'Word エクスポート' },
              { ok: true, label: 'PDF エクスポート' },
            ].map(({ ok, label }) => (
              <li class="flex items-center gap-2 text-gray-300">
                <span class="text-xs shrink-0 text-purple-400">✓</span>
                {label}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-center text-xs text-gray-400">クレジットカード決済 · Stripe で安全に処理 · いつでもキャンセル可能</p>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section id="faq" class="py-20 px-4 bg-gray-50">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-black text-center text-gray-900 mb-12">よくある質問</h2>

      <div class="space-y-4">
        {[
          {
            q: 'ChatGPTと何が違うの？',
            a: 'ChatGPTは文章生成が得意ですが、実在する学術論文を引用してくれません。ポチレポはCiNii APIと連携して実際の論文を検索し、正しい引用フォーマットで文章に組み込みます。「参考文献つきで先生に出せるレポート」を作れる点が大きな違いです。',
          },
          {
            q: '大学にバレませんか？',
            a: 'ポチレポは「全自動生成」ではなく「作業効率化」を目的としています。自分の考えや授業メモ、集めた論文をもとに構成と表現をサポートします。最終的には自分で内容を確認・編集することで、自分のレポートとして仕上げてください。',
          },
          {
            q: '無料でどこまで使えますか？',
            a: '無料プランではレポート生成を2回（通算）まで、最大2,000字で利用できます。参考文献フォーマッターはユーザー登録なしで無制限に使えます。CiNii論文検索・音声文字起こし・ファイル読み込みはStandard以上のプランです。',
          },
          {
            q: 'スマートフォンでも使えますか？',
            a: 'はい、スマートフォン・タブレットにも対応しています。ただしレポートの編集や長文入力にはパソコンでのご利用をおすすめします。',
          },
          {
            q: '対応している学部・分野は？',
            a: '法学・経済学・社会学・文学・教育学・心理学・経営学など、主に文系の学部に対応しています。理系の実験レポートには現時点では最適化されていません。',
          },
          {
            q: 'CiNiiって何ですか？',
            a: 'CiNii（サイニィ）は国立情報学研究所が運営する国内最大の学術情報データベースです。日本の大学・研究機関が発表した論文を2,000万件以上収録しています。大学のレポートで引用する論文を探すのに最適です。',
          },
        ].map(({ q, a }) => (
          <details class="group bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
            <summary class="flex justify-between items-center cursor-pointer px-5 py-4 font-semibold text-gray-800 hover:bg-gray-50 transition list-none">
              {q}
              <span class="text-gray-400 group-open:rotate-180 transition-transform text-lg ml-2">▾</span>
            </summary>
            <p class="px-5 pb-5 text-sm text-gray-600 leading-relaxed border-t border-gray-50 pt-3">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== FINAL CTA ===== -->
  <section class="py-20 px-4 bg-gradient-to-br from-gray-900 to-gray-800 text-white text-center">
